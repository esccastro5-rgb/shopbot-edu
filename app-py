from fastapi import FastAPI, HTTPException
from fastapi.middleware.cors import CORSMiddleware
import time
import hashlib
import hmac
import requests
import uvicorn
import os

app = FastAPI(title="Shopbot Shopee Affiliate API")

app.add_middleware(
    CORSMiddleware,
    allow_origins=["*"],
    allow_methods=["*"],
    allow_headers=["*"],
)

APP_ID = os.getenv("SHOPEE_APP_ID", "18345391314")
SECRET = os.getenv("SHOPEE_SECRET", "6725SZ3YRZPDP52Q6KKEMAOSYTJHX5AD")
GRAPHQL_URL = os.getenv("SHOPEE_GRAPHQL_URL", "https://open-api.affiliate.shopee.com.br/graphql")

def generate_signature(app_id: str, secret: str, timestamp: int):
    payload = f"{app_id}{timestamp}"
    sig_hmac = hmac.new(secret.encode(), payload.encode(), hashlib.sha256).hexdigest()
    sig_simple = hashlib.sha256(f"{app_id}{timestamp}{secret}".encode()).hexdigest()
    return sig_hmac, sig_simple

@app.get("/")
def home():
    return {"status": "Shopbot API Online", "app_id": APP_ID, "message": "Use /api/products?limit=20"}

@app.get("/api/products")
def get_products(limit: int = 20, keyword: str = ""):
    timestamp = int(time.time())
    sig_hmac, sig_simple = generate_signature(APP_ID, SECRET, timestamp)
    headers = {
        "Content-Type": "application/json",
        "Authorization": f"SHA256 Credential={APP_ID}, Timestamp={timestamp}, Signature={sig_hmac}"
    }
    query = """
    query {
      productOfferV2(listType: 0, sortType: 2, limit: %d, keyword: "%s") {
        nodes {
          [STRIPPED 72 bytes]
        }
        pageInfo { total }
      }
    }
    """ % (limit, keyword)
    payload = {"query": query}
    try:
        resp = requests.post(GRAPHQL_URL, json=payload, headers=headers, timeout=15)
        if resp.status_code != 200:
            headers["Authorization"] = f"SHA256 Credential={APP_ID}, Timestamp={timestamp}, Signature={sig_simple}"
            resp = requests.post(GRAPHQL_URL, json=payload, headers=headers, timeout=15)
        data = resp.json()
        return {
            "success": True,
            "timestamp": timestamp,
            "shopee_response": data,
            "affiliate_base_link": "https://s.shopee.com.br/9KjDHIgdYK"
        }
    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))

if __name__ == "__main__":
    uvicorn.run(app, host="0.0.0.0", port=8000)
